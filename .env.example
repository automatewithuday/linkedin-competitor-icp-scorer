APIFY_TOKEN=
# LLM for ICP scoring. Optional: in a Claude Code session the agent scores in-session (run.py --scores) with no key.
# For automatic scoring pick ONE:
#  (a) OpenAI API key (pay per token)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
#  (b) Your Claude subscription via the `claude` CLI (Claude Code, logged in). No key needed.
#      Set LLM_PROVIDER=claude to force it when both are available.
LLM_PROVIDER=
CLAUDE_MODEL=sonnet
# Optional: automatic ICP derivation from a website
FIRECRAWL_API_KEY=
# Required only for email enrichment
PROSPEO_API_KEY=
# Required only for an actual campaign import; previews work without it
SMARTLEAD_API_KEY=
# Required only for an actual HeyReach push (LinkedIn outreach); previews work without it
HEYREACH_API_KEY=
# Optional database destination; server-side keys only
SUPABASE_URL=
SUPABASE_SECRET_KEY=
# Legacy alternative to SUPABASE_SECRET_KEY
SUPABASE_SERVICE_ROLE_KEY=
# Required only for --activity (LinkedIn activity intel)
TYPESAFE_API_KEY=
